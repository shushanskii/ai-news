exports[`ResearchForm > does not submit a prompt too short to search for 1`] = `
<DocumentFragment>
  <form
    class="sc-dkHxwO gKQpAI"
  >
    <label
      class="sc-hLllbt fqldWW"
    >
      Тема
      <textarea
        placeholder="например: что произошло с ценами на SSD за последнюю неделю"
        rows="3"
      >
          ai  
      </textarea>
    </label>
    <label
      class="sc-hLllbt fqldWW"
    >
      Системный промпт
      <textarea
        placeholder="необязательно: чем агент должен отличаться от обычного"
        rows="2"
      />
    </label>
    <fieldset
      class="sc-jTkVfb kUkrmx"
    >
      <legend
        class="sc-gLfMdy dOzBEh"
      >
        Инструменты
      </legend>
      <div
        class="sc-iBIXdp klsOgr"
      >
        <label
          class="sc-bcHNtg lmxgaW"
        >
          <input
            checked=""
            type="checkbox"
          />
          Поиск
          <span
            class="sc-gsMGyr bZLmDc"
          >
            SearXNG
          </span>
        </label>
        <label
          class="sc-bcHNtg lmxgaW"
        >
          <input
            checked=""
            type="checkbox"
          />
          Чтение страниц
          <span
            class="sc-gsMGyr bZLmDc"
          >
            Crawl4AI
          </span>
        </label>
      </div>
    </fieldset>
    <div
      class="sc-eDgbZQ fmNsLO"
    >
      <label
        class="sc-hLllbt fqldWW"
      >
        Источников не больше
        <input
          max="20"
          min="1"
          type="number"
          value="8"
        />
      </label>
      <label
        class="sc-hLllbt fqldWW"
      >
        Язык ответа
        <select>
          <option
            value=""
          >
            как в запросе
          </option>
          <option
            value="ru"
          >
            русский
          </option>
          <option
            value="en"
          >
            английский
          </option>
        </select>
      </label>
    </div>
    <button
      disabled=""
      type="submit"
    >
      Искать новости
    </button>
  </form>
</DocumentFragment>
`;

