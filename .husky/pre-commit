# The gate lives in scripts/gate.mjs, so this hook and a human at a keyboard run one thing.
# `--no-verify` still bypasses this, and there is no pipeline behind it yet — see
# conventions/project.md, "CI is not running".
if ! pnpm run verify; then
  echo ""
  echo "✖ pre-commit failed — fix the issues reported above, then re-commit."
  exit 1
fi
