# Copy to `.env` and adjust. Every value below is the default the code already uses, so an absent
# line is not a broken deployment — it is the lab's own setup.
#
# The file is read at startup by apps/api, walking up from the working directory, so the repository
# root copy serves `pnpm dev` and a bundled `node dist/main.js` alike.

# --- the model ---------------------------------------------------------------------------
# Any OpenAI-compatible chat endpoint. The key is only what the SDK demands: an endpoint with no
# auth still wants a non-empty string here.
LLM_BASE_URL=https://halogen.rezolver-zero.com/v1
LLM_API_KEY=none
LLM_MODEL=qwen3.8-flash-next
# Low on purpose: this endpoint reports facts about pages, it is not being creative.
LLM_TEMPERATURE=0.2

# --- SearXNG, the search tool ------------------------------------------------------------
SEARXNG_URL=https://search.rezolver-zero.com
# `news` narrows to news engines; `general` searches the whole index.
SEARXNG_CATEGORY=news
SEARXNG_TIMEOUT_MS=30000
SEARXNG_MAX_RESULTS=8

# --- Crawl4AI, the page reader -----------------------------------------------------------
CRAWL4AI_URL=https://fetch.rezolver-zero.com
# Bearer token, read on every call so a rotation needs no restart. Keep the file 0600 and out of
# the repository: a token in the environment can end up in a log line, one in a file usually does not.
CRAWL4AI_TOKEN_FILE=~/.pi/agent/mcp/c4a.token
# A cold Chromium plus a slow site: this is the one timeout that has to be generous.
CRAWL4AI_TIMEOUT_MS=120000
# Characters of page text handed to the model per read.
CRAWL4AI_MAX_CHARS=12000

# --- the agent loop ----------------------------------------------------------------------
# Ceiling on model round trips. Each round is a search or a page read, so this is also the ceiling
# on how long one request takes.
AGENT_MAX_STEPS=8
# Only set this to replace the whole research instructions; per-request instructions belong in the
# `systemPrompt` field of the request.
# AGENT_SYSTEM_PROMPT=

# --- the service -------------------------------------------------------------------------
PORT=3000
# How long one research run may take before the service stops waiting and answers 504.
NEWS_TIMEOUT_MS=300000

# --- logs ----------------------------------------------------------------------------------
# Written to stderr, so whatever the process prints to stdout stays clean.
#   LOG_LEVEL  debug | info | warn | error | silent   (default info)
#   LOG_FORMAT text  | json                           (default text)
# debug adds the health checks and the size of every model request; json is one object per line for
# a log collector. A run is joined together by its runId, a request by its requestId, and the two
# appear on the same lines.
# LOG_LEVEL=info
# LOG_FORMAT=text

# --- the browser ---------------------------------------------------------------------------
# Where the Vite dev server proxies /api. Only needed when the service runs elsewhere.
# API_URL=http://localhost:3000
