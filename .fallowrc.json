{
  "$schema": "./node_modules/fallow/schema.json",
  "boundaries": {
    "zones": [
      {
        "name": "shared-test",
        "patterns": ["packages/shared/src/**/*.test.ts"]
      },
      {
        "name": "api-test",
        "patterns": ["apps/api/src/**/*.test.ts"]
      },
      {
        "name": "agent-test",
        "patterns": ["packages/agent/src/**/*.test.ts"]
      },
      {
        "name": "web-test",
        "patterns": ["apps/web/src/**/*.test.ts", "apps/web/src/**/*.test.tsx"]
      },

      { "name": "shared-types", "patterns": ["packages/shared/src/types/**"] },
      { "name": "shared-schemas", "patterns": ["packages/shared/src/schemas/**"] },
      { "name": "shared-barrel", "patterns": ["packages/shared/src/index.ts"] },

      { "name": "agent-types", "patterns": ["packages/agent/src/types/**"] },
      { "name": "agent-errors", "patterns": ["packages/agent/src/errors/**"] },
      { "name": "agent-schemas", "patterns": ["packages/agent/src/schemas/**"] },
      { "name": "agent-config", "patterns": ["packages/agent/src/config/**"] },
      { "name": "agent-logging", "patterns": ["packages/agent/src/logging/**"] },
      { "name": "agent-bibliography", "patterns": ["packages/agent/src/bibliography/**"] },
      { "name": "agent-tools", "patterns": ["packages/agent/src/tools/**"] },
      { "name": "agent-model", "patterns": ["packages/agent/src/model/**"] },
      { "name": "agent-state", "patterns": ["packages/agent/src/state/**"] },
      { "name": "agent-nodes", "patterns": ["packages/agent/src/nodes/**"] },
      { "name": "agent-edges", "patterns": ["packages/agent/src/edges/**"] },
      { "name": "agent-graph", "patterns": ["packages/agent/src/graph/**"] },
      { "name": "agent-barrel", "patterns": ["packages/agent/src/index.ts"] },

      { "name": "api-services", "patterns": ["apps/api/src/services/**"] },
      { "name": "api-routes", "patterns": ["apps/api/src/routes/**"] },
      { "name": "api-middleware", "patterns": ["apps/api/src/middleware/**"] },
      { "name": "api-app", "patterns": ["apps/api/src/app/**"] },
      { "name": "api-entry", "patterns": ["apps/api/src/main.ts"] },

      { "name": "web-api", "patterns": ["apps/web/src/api/**"] },
      { "name": "web-actions", "patterns": ["apps/web/src/actions/**"] },
      { "name": "web-reducers", "patterns": ["apps/web/src/reducers/**"] },
      { "name": "web-sagas", "patterns": ["apps/web/src/sagas/**"] },
      { "name": "web-store", "patterns": ["apps/web/src/store/**"] },
      { "name": "web-selectors", "patterns": ["apps/web/src/selectors/**"] },
      { "name": "web-hooks", "patterns": ["apps/web/src/hooks/**"] },
      { "name": "web-components", "patterns": ["apps/web/src/components/**"] },
      { "name": "web-entry", "patterns": ["apps/web/src/main.tsx"] },

      { "name": "repo-tooling", "patterns": ["scripts/**"] }
    ],
    "rules": [
      {
        "from": "shared-test",
        "allow": ["shared-types", "shared-schemas", "shared-barrel"]
      },
      {
        "from": "api-test",
        "allow": [
          "api-services",
          "api-routes",
          "api-middleware",
          "api-app",
          "api-entry",
          "agent-barrel",
          "shared-barrel"
        ]
      },
      {
        "from": "agent-test",
        "allow": [
          "agent-types",
          "agent-errors",
          "agent-schemas",
          "agent-config",
          "agent-logging",
          "agent-bibliography",
          "agent-tools",
          "agent-model",
          "agent-state",
          "agent-nodes",
          "agent-edges",
          "agent-graph",
          "agent-barrel",
          "shared-barrel"
        ]
      },
      {
        "from": "web-test",
        "allow": [
          "web-api",
          "web-actions",
          "web-reducers",
          "web-sagas",
          "web-store",
          "web-selectors",
          "web-hooks",
          "web-components",
          "web-entry",
          "shared-barrel"
        ]
      },

      { "from": "shared-types", "allow": [] },
      { "from": "shared-schemas", "allow": ["shared-types"] },
      { "from": "shared-barrel", "allow": ["shared-types", "shared-schemas"] },

      {
        "from": "agent-types",
        "allow": []
      },
      { "from": "agent-errors", "allow": ["agent-types"] },
      { "from": "agent-schemas", "allow": ["agent-types"] },
      { "from": "agent-config", "allow": ["agent-errors", "agent-types"] },
      { "from": "agent-logging", "allow": [] },
      { "from": "agent-bibliography", "allow": ["agent-types", "shared-barrel"] },
      {
        "from": "agent-tools",
        "allow": ["agent-config", "agent-errors", "agent-schemas", "agent-types", "shared-barrel"]
      },
      { "from": "agent-model", "allow": ["agent-config", "agent-schemas", "agent-types"] },
      { "from": "agent-state", "allow": ["agent-schemas", "shared-barrel"] },
      {
        "from": "agent-nodes",
        "allow": [
          "agent-errors",
          "agent-logging",
          "agent-model",
          "agent-state",
          "agent-types",
          "shared-barrel"
        ]
      },
      { "from": "agent-edges", "allow": ["agent-state"] },
      {
        "from": "agent-graph",
        "allow": [
          "agent-bibliography",
          "agent-config",
          "agent-errors",
          "agent-edges",
          "agent-logging",
          "agent-model",
          "agent-nodes",
          "agent-state",
          "agent-tools",
          "agent-types",
          "shared-barrel"
        ]
      },
      {
        "from": "agent-barrel",
        "allow": ["agent-config", "agent-errors", "agent-graph", "agent-logging", "agent-types"]
      },
      { "from": "api-services", "allow": ["agent-barrel", "shared-barrel"] },
      { "from": "api-routes", "allow": ["api-services", "agent-barrel", "shared-barrel"] },
      { "from": "api-middleware", "allow": ["agent-barrel"] },
      {
        "from": "api-app",
        "allow": ["api-middleware", "api-routes", "api-services", "agent-barrel", "shared-barrel"]
      },
      {
        "from": "api-entry",
        "allow": ["api-app", "api-routes", "api-services", "agent-barrel", "shared-barrel"]
      },

      { "from": "web-api", "allow": ["shared-barrel"] },
      { "from": "web-actions", "allow": ["shared-barrel"] },
      { "from": "web-reducers", "allow": ["shared-barrel"] },
      {
        "from": "web-sagas",
        "allow": ["web-api", "web-actions", "web-reducers", "shared-barrel"]
      },
      { "from": "web-store", "allow": ["web-reducers", "web-sagas", "shared-barrel"] },
      { "from": "web-selectors", "allow": ["web-store", "web-actions", "shared-barrel"] },
      {
        "from": "web-hooks",
        "allow": ["web-selectors", "web-store", "web-actions", "shared-barrel"]
      },
      { "from": "web-components", "allow": ["web-hooks", "web-components", "shared-barrel"] },
      {
        "from": "web-entry",
        "allow": ["web-components", "web-store", "web-sagas", "shared-barrel"]
      },

      { "from": "repo-tooling", "allow": [] }
    ],
    "coverage": {
      "requireAllFiles": true,
      "allowUnmatched": [
        "apps/api/tsup.config.ts",
        "apps/web/vite.config.ts",
        "apps/web/vitest.config.ts",
        "apps/web/vitest.setup.ts",
        "apps/web/index.html"
      ]
    },
    "calls": {
      "forbidden": [
        {
          "from": "web-components",
          "callee": ["useSelector", "useDispatch", "fetch"]
        },
        {
          "from": "web-selectors",
          "callee": "fetch"
        },
        {
          "from": "web-reducers",
          "callee": "fetch"
        },
        {
          "from": "web-actions",
          "callee": "fetch"
        },
        {
          "from": "web-sagas",
          "callee": "fetch"
        },
        {
          "from": "web-store",
          "callee": "fetch"
        },
        {
          "from": "web-hooks",
          "callee": "fetch"
        },
        {
          "from": "web-entry",
          "callee": "fetch"
        }
      ]
    }
  }
}
